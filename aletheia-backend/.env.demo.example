#
# Demo environment example (safe template).
#
# Prefer copying to `.env.demo` for local overrides.
# When `.env.demo` is missing, demo scripts reuse DATABASE_URL from `.env.test` with the
# database name switched to `aletheia_demo` (see `scripts/db/loadDemoEnv.ts`). Otherwise this
# file supplies DATABASE_URL and JWT defaults.
#
# IMPORTANT:
# - Database NAME must include "demo" (e.g. aletheia_demo), or scripts refuse to run.
# - Default URL below matches many local Postgres/Docker setups (user postgres, password postgres).
#   If Prisma reports P1000, put your real credentials in `.env.demo` (copy this file), or copy
#   DATABASE_URL from `.env.test` and only change the database name to `aletheia_demo`.
#

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aletheia_demo?schema=public"

# Wipe demo schema, re-run migrations, and re-seed (development only):
#   npm run db:reset:demo

# Optional: align with your dev stack
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

